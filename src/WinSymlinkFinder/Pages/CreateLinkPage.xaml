<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinSymlinkFinder.Pages.CreateLinkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="12,14,16,16">
        <StackPanel HorizontalAlignment="Stretch" Spacing="16">
            <!-- En-tête -->
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Créer un lien ou point de jonction" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Liez facilement vos dossiers et fichiers pour libérer de l'espace disque ou synchroniser des répertoires sans duplication." />
            </StackPanel>

            <!-- Formulaire de création -->
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="20">
                    <!-- 1. Choix du type de lien -->
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="1. Type de lien à créer" />
                        <RadioButtons x:Name="LinkTypeRadioButtons" SelectedIndex="0" SelectionChanged="LinkTypeRadioButtons_SelectionChanged">
                            <RadioButton Content="Point de jonction NTFS (Dossiers locaux - Recommandé, ne requiert aucun droit administrateur)" Tag="Junction" IsChecked="True" />
                            <RadioButton Content="Lien symbolique de dossier (Directory Symlink - Supporte partages SMB et chemins relatifs)" Tag="SymlinkDir" />
                            <RadioButton Content="Lien symbolique de fichier (File Symlink - Pour fichiers individuels)" Tag="SymlinkFile" />
                            <RadioButton Content="Lien physique (Hard Link fichier - Même partition NTFS uniquement)" Tag="HardLink" />
                        </RadioButtons>
                    </StackPanel>

                    <!-- 2. Source : Fichier ou dossier existant -->
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xED43;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock FontWeight="SemiBold" Text="2. Fichier ou dossier d'origine existant (Source réelle de vos données)" />
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="TargetPathTextBox"
                                Grid.Column="0"
                                PlaceholderText="ex: C:\Users\Arnaud\OneDrive\Backup\savedata ou D:\Donnees\Archives"
                                Text="{x:Bind ViewModel.TargetPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                Click="BrowseTargetFolder_Click"
                                ToolTipService.ToolTip="Sélectionner le dossier réel existant">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xED25;" FontSize="14" />
                                    <TextBlock Text="Dossier existant..." />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="2"
                                Click="BrowseTargetFile_Click"
                                ToolTipService.ToolTip="Sélectionner le fichier réel existant">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="14" />
                                    <TextBlock Text="Fichier existant..." />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Sélectionnez le dossier ou fichier existant sur votre disque contenant vos données réelles." />
                    </StackPanel>

                    <!-- 3. Destination : Emplacement du nouveau lien -->
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71B;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock FontWeight="SemiBold" Text="3. Emplacement du nouveau lien à créer (Raccourci / Point d'accès virtuel)" />
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="LinkPathTextBox"
                                Grid.Column="0"
                                PlaceholderText="ex: E:\Jeux\Uncharted\user\savedata ou C:\Projets\MonLien"
                                Text="{x:Bind ViewModel.LinkPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                Click="BrowseLinkFolder_Click"
                                ToolTipService.ToolTip="Choisir le dossier conteneur">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xED25;" FontSize="14" />
                                    <TextBlock Text="Dossier parent..." />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Indiquez l'emplacement où sera créé le lien virtuel (ex: l'endroit où le jeu ou l'application s'attend à trouver ses données). Aucun élément ne doit déjà exister à ce chemin exact." />
                    </StackPanel>

                    <!-- 4. Aperçu visuel de la redirection -->
                    <Border
                        Padding="12"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6">
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Aperçu du fonctionnement :" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Point d'accès (Nouveau lien) :" />
                                    <TextBlock FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Text="{x:Bind ViewModel.LinkPath, Mode=OneWay, FallbackValue='(non spécifié)'}" />
                                </StackPanel>

                                <FontIcon Grid.Column="1" VerticalAlignment="Center" Glyph="&#xE72A;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Pointe vers vos données réelles :" />
                                    <TextBlock FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Text="{x:Bind ViewModel.TargetPath, Mode=OneWay, FallbackValue='(non spécifié)'}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 5. Options -->
                    <StackPanel Spacing="4">
                        <CheckBox
                            Content="Créer un lien relatif (Recommandé uniquement pour la portabilité entre dossiers sur le même lecteur)"
                            IsChecked="{x:Bind ViewModel.IsRelative, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.CanBeRelative, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.RelativeOptionHelpText, Mode=OneWay}" />
                    </StackPanel>

                    <!-- 6. Bouton de soumission -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            Command="{x:Bind ViewModel.CreateLinkCommand}"
                            IsEnabled="{x:Bind ViewModel.CanCreateLink, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Créer le lien maintenant" />
                            </StackPanel>
                        </Button>
                        <ProgressRing
                            IsActive="{x:Bind ViewModel.IsCreating, Mode=OneWay}"
                            Width="20"
                            Height="20" />
                    </StackPanel>

                    <!-- 7. Message d'information / erreur avec actions de récupération -->
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                        Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}">
                        <InfoBar.ActionButton>
                            <Button
                                Content="Basculer en Jonction NTFS"
                                Command="{x:Bind ViewModel.SwitchToJunctionCommand}"
                                Visibility="{x:Bind ViewModel.ShowSwitchToJunctionButtonVisibility, Mode=OneWay}" />
                        </InfoBar.ActionButton>
                        <InfoBar.Content>
                            <HyperlinkButton
                                Content="Ouvrir les Paramètres Développeur Windows..."
                                Command="{x:Bind ViewModel.OpenDevSettingsCommand}"
                                Visibility="{x:Bind ViewModel.ShowOpenDevSettingsButtonVisibility, Mode=OneWay}" />
                        </InfoBar.Content>
                    </InfoBar>
                </StackPanel>
            </Border>

            <!-- Guide des types de liens -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Aide au choix du type de lien" />
                    </StackPanel>

                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Jonction NTFS -->
                        <Border Grid.Row="0" Grid.Column="0" Padding="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock FontWeight="SemiBold" Text="Jonction NTFS (Dossiers locaux)" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Recommandé sous Windows pour les dossiers locaux (ex: déplacer des sauvegardes de jeux ou de profils sur un autre disque). Fonctionne immédiatement sans aucun privilège administrateur." />
                            </StackPanel>
                        </Border>

                        <!-- Symlink Dossier -->
                        <Border Grid.Row="0" Grid.Column="1" Padding="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xED25;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock FontWeight="SemiBold" Text="Symlink Dossier" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Pointe vers un dossier local ou distant (partage SMB réseau). Nécessite le Mode Développeur de Windows ou une exécution administrateur." />
                            </StackPanel>
                        </Border>

                        <!-- Symlink Fichier -->
                        <Border Grid.Row="1" Grid.Column="0" Padding="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock FontWeight="SemiBold" Text="Symlink Fichier" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Pointe vers un fichier unique. Transparent pour la quasi-totalité des applications." />
                            </StackPanel>
                        </Border>

                        <!-- Hard Link -->
                        <Border Grid.Row="1" Grid.Column="1" Padding="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE71B;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock FontWeight="SemiBold" Text="Hard Link" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Pointe directement sur la même entrée MFT d'un fichier. Obligatoirement sur la même partition NTFS (impossible entre C: et E:)." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
