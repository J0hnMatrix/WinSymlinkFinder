<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinSymlinkFinder.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="10,12,16,16">
        <StackPanel HorizontalAlignment="Stretch" Spacing="16">
            <!-- En-tête -->
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Paramètres" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Personnalisez l'apparence et les options de l'application." />
            </StackPanel>

            <!-- Apparence -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Apparence" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Sélectionnez le thème d'affichage de l'application." />

                    <RadioButtons x:Name="ThemeRadioButtons" SelectionChanged="ThemeRadioButtons_SelectionChanged">
                        <RadioButton Content="Thème clair" Tag="Light" />
                        <RadioButton Content="Thème sombre" Tag="Dark" />
                        <RadioButton Content="Paramètre Windows par défaut" IsChecked="True" Tag="Default" />
                    </RadioButtons>
                </StackPanel>
            </Border>

            <!-- À propos de l'application -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Informations de version" />
                    
                    <Button
                        x:Name="VersionButton"
                        Click="VersionButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}">
                            <Bold>WinSymlinkFinder</Bold> version 1.3.0<LineBreak />
                            Cadre d'application : Windows App SDK / WinUI 3<LineBreak />
                            Runtime : .NET 8.0 (x64 / ARM64)
                        </TextBlock>
                    </Button>

                    <InfoBar
                        x:Name="DebugTipInfoBar"
                        IsOpen="False"
                        Severity="Informational" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
